# ProofStack Monorepo Environment Variables Template
# Backend Port
PORT=5000

# Backend CORS Allowed Origins (comma separated)
CLIENT_URL=http://localhost:5173

# Frontend API Base URL (if overriding default Vite proxy)
VITE_API_URL=http://localhost:5000/api

# Google Gemini API Key (Required for Phase 2 Claim Extraction in backend/.env)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash


